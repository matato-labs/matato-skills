<Layouts.app flash={@flash}>
  <div class="h-screen overflow-hidden bg-base-300 text-base-content">
    <div class="grid h-full lg:grid-cols-[17rem_minmax(0,1fr)]">
      <SessionComponents.sidebar
        workspace_groups={@workspace_groups}
        automation_groups={@automation_groups}
        general_sessions={@general_sessions}
        session_id={@session_id}
        delete_session_id={@delete_session_id}
        mobile_sidebar_open={@mobile_sidebar_open}
      />
      <div
        :if={@mobile_sidebar_open}
        id="mobile-sidebar-backdrop"
        phx-click="close_mobile_sidebar"
        class="fixed inset-0 z-20 bg-base-300/70 lg:hidden"
        aria-hidden="true"
      >
      </div>

      <main class="relative flex h-full min-h-0 flex-col overflow-hidden bg-base-300 pt-16 lg:pt-0">
        <SessionComponents.chat_header
          chat_name={@chat_name}
          mobile_sidebar_open={@mobile_sidebar_open}
        />
        <%= if @session do %>
          <section
            id="transcript"
            phx-hook="Transcript"
            class="min-h-0 flex-1 overflow-y-auto px-5 py-8 lg:px-8"
            aria-live="polite"
          >
            <div class="mx-auto max-w-6xl space-y-7">
              <div
                :if={@session.status == :interrupted}
                id="interrupted-run"
                class="rounded-lg border border-warning/25 bg-warning/5 px-4 py-3 text-sm text-warning"
                role="status"
              >
                The previous run was interrupted. Completed history was restored; prompts were not replayed.
              </div>

              <div
                :for={notice <- @session.notices}
                class="rounded-lg border border-base-content/10 bg-base-200 px-4 py-3 text-sm"
                role="status"
              >
                {notice["message"]}
              </div>

              <div
                :if={@session.messages == [] && partial_items(@session) == []}
                class="py-20 text-center"
              >
                <div class="mx-auto mb-4 grid size-11 place-items-center rounded-xl bg-base-200 text-base-content/45">
                  <.icon name="hero-sparkles" class="size-5" />
                </div>
                <h2 class="text-base font-semibold">Ready for a task</h2>
              </div>

              <div id="messages" phx-update="stream" class="contents">
                <.transcript_item :for={{id, item} <- @streams.messages} id={id} item={item} />
              </div>

              <div
                :if={@session.error}
                class="rounded-lg border border-error/30 bg-error/8 px-4 py-3 text-sm text-error"
                role="alert"
              >
                {@session.error}
              </div>
              <div
                :if={@error}
                id="session-error"
                class="rounded-lg border border-error/30 bg-error/8 px-4 py-3 text-sm text-error"
                role="alert"
              >
                {@error}
              </div>
            </div>
          </section>

          <section
            :if={@session.dialog}
            class="border-t border-warning/25 bg-warning/5 px-5 py-4 lg:px-8"
          >
            <div class="mx-auto max-w-3xl">
              <p class="text-xs font-semibold uppercase tracking-wider text-warning">
                Agent needs input
              </p>
              <h2 class="mt-1 text-sm font-semibold">{@session.dialog["title"]}</h2>
              <p :if={@session.dialog["message"]} class="mt-1 text-sm text-base-content/60">
                {@session.dialog["message"]}
              </p>

              <div :if={@session.dialog["method"] == "select"} class="mt-3 flex flex-wrap gap-2">
                <button
                  :for={option <- @session.dialog["options"]}
                  id={"dialog-option-#{:erlang.phash2(option)}"}
                  phx-click="dialog"
                  phx-value-value={option}
                  class="btn btn-sm btn-outline"
                >{option}</button>
                <button
                  id="dialog-cancel"
                  phx-click="dialog"
                  phx-value-cancel="true"
                  class="btn btn-sm btn-ghost"
                >Cancel</button>
              </div>

              <div :if={@session.dialog["method"] == "confirm"} class="mt-3 flex gap-2">
                <button
                  id="dialog-confirm"
                  phx-click="dialog"
                  phx-value-answer="true"
                  class="btn btn-sm btn-primary"
                >Confirm</button>
                <button
                  id="dialog-decline"
                  phx-click="dialog"
                  phx-value-answer="false"
                  class="btn btn-sm btn-ghost"
                >Cancel</button>
              </div>

              <.form
                :if={@session.dialog["method"] in ["input", "editor"]}
                for={@dialog_form}
                id="dialog-form"
                phx-submit="dialog"
                class="mt-3 flex items-end gap-2"
              >
                <.input
                  field={@dialog_form[:value]}
                  type="textarea"
                  rows={if @session.dialog["method"] == "editor", do: 5, else: 1}
                  placeholder={@session.dialog["placeholder"]}
                  class="textarea textarea-bordered min-h-10 flex-1 bg-base-200 text-sm"
                />
                <button class="btn btn-sm btn-primary">Submit</button>
                <button
                  type="button"
                  phx-click="dialog"
                  phx-value-cancel="true"
                  class="btn btn-sm btn-ghost"
                >Cancel</button>
              </.form>
            </div>
          </section>

          <footer class="shrink-0 border-t border-base-content/10 bg-base-300 px-5 py-4 lg:px-8">
            <div class="mx-auto max-w-3xl space-y-2">
              <section
                :if={@session.queue["steering"] != []}
                id="queued-steering"
                class="mx-2 rounded-md border border-base-content/10 bg-base-200/70 px-3 py-2 text-sm text-base-content/75"
                role="status"
                aria-label="Queued steering message"
              >
                <p :for={message <- @session.queue["steering"]} class="whitespace-pre-wrap">
                  {message}
                </p>
                <p class="mt-1 text-[11px] text-base-content/35">
                  Enter to steer · Alt + Enter to follow up · Esc to undo
                </p>
              </section>
              <section
                :if={@session.queue["followUp"] != []}
                id="queued-follow-up"
                class="flex items-start gap-3 rounded-lg border border-warning/25 bg-warning/5 px-3 py-2.5 text-sm"
                role="status"
              >
                <.icon name="hero-clock" class="mt-0.5 size-4 shrink-0 text-warning" />
                <div class="min-w-0 flex-1">
                  <p class="text-xs font-semibold uppercase tracking-wide text-warning">
                    Up next
                  </p>
                  <p
                    :for={message <- @session.queue["followUp"]}
                    class="mt-0.5 whitespace-pre-wrap text-base-content"
                  >
                    {message}
                  </p>
                </div>
              </section>
            </div>
            <.form
              for={@composer_form}
              id="composer-form"
              phx-submit="compose"
              phx-change="draft"
              phx-hook="Composer"
              class="relative mx-auto max-w-3xl"
            >
              <div
                id="slash-command-picker"
                role="listbox"
                hidden={@draft == "" || !String.starts_with?(@draft, "/")}
                class="absolute inset-x-0 bottom-full mb-2 max-h-72 overflow-y-auto rounded-xl border border-base-content/15 bg-base-100 p-1 shadow-xl"
              >
                <button
                  :for={command <- @session.commands}
                  id={"slash-command-#{command["name"]}"}
                  type="button"
                  role="option"
                  data-slash-command={command["name"]}
                  title={command_path(command)}
                  class="slash-command-option flex w-full items-start gap-3 rounded-lg px-3 py-2 text-left transition hover:bg-base-200 focus:bg-base-200 focus:outline-none"
                >
                  <span class="font-mono text-sm font-semibold text-primary">/{command["name"]}</span>
                  <span class="min-w-0 flex-1">
                    <span :if={command["description"]} class="block truncate text-sm">{command[
                      "description"
                    ]}</span>
                    <span class="block text-xs text-base-content/45">{command["source"]} · {command_location(
                      command
                    )}</span>
                  </span>
                </button>
                <p id="slash-command-empty" class="px-3 py-2 text-sm text-base-content/50">
                  No commands match this session.
                </p>
              </div>
              <p
                :if={@session.commands_error}
                id="command-discovery-error"
                class="mb-2 text-xs text-warning"
                role="status"
              >
                {@session.commands_error}
              </p>
              <div
                id="composer-box"
                class="rounded-2xl border border-base-content/15 bg-base-200 px-4 pb-1.5 pt-3 transition-colors focus-within:border-base-content/30"
              >
                <textarea
                  id="composer-message"
                  name={@composer_form[:message].name}
                  rows="3"
                  placeholder="Ask Pi to work on a task…"
                  aria-controls="slash-command-picker"
                  aria-expanded={@draft != "" && String.starts_with?(@draft, "/")}
                  class="w-full resize-none bg-transparent text-sm leading-6 placeholder:text-base-content/30 focus:outline-none"
                >{@composer_form[:message].value}</textarea>
                <div class="mt-1 flex flex-nowrap items-center gap-y-1">
                  <label :if={@available_models != []} class="relative flex shrink-0 items-center">
                    <select
                      id="model-select"
                      name="model"
                      phx-change="set_model"
                      aria-label="Model"
                      class="max-w-36 cursor-pointer appearance-none truncate rounded-lg bg-transparent py-1.5 pl-2.5 pr-7 text-xs font-medium text-base-content/70 hover:bg-base-content/5 hover:text-base-content focus:outline-none"
                    >
                      <option
                        :for={model <- @available_models}
                        value={"#{model["provider"]}/#{model["id"]}"}
                        selected={
                          @session.model != nil && @session.model["provider"] == model["provider"] &&
                            @session.model["id"] == model["id"]
                        }
                      >
                        {model["name"] || model["id"]}
                      </option>
                    </select>
                    <.icon
                      name="hero-chevron-down"
                      class="pointer-events-none absolute right-2 size-3 text-base-content/40"
                    />
                  </label>
                  <span
                    :if={@available_models != [] && @thinking_levels != []}
                    class="mx-1 h-4 w-px bg-base-content/10"
                  />
                  <label :if={@thinking_levels != []} class="relative flex shrink-0 items-center">
                    <select
                      id="thinking-level-select"
                      name="level"
                      phx-change="set_thinking_level"
                      aria-label="Thinking level"
                      class="cursor-pointer appearance-none rounded-lg bg-transparent py-1.5 pl-2.5 pr-7 text-xs font-medium text-base-content/70 hover:bg-base-content/5 hover:text-base-content focus:outline-none"
                    >
                      <option
                        :for={level <- @thinking_levels}
                        value={level}
                        selected={@session[:thinking_level] == level}
                      >
                        {String.capitalize(level)}
                      </option>
                    </select>
                    <.icon
                      name="hero-chevron-down"
                      class="pointer-events-none absolute right-2 size-3 text-base-content/40"
                    />
                  </label>
                  <div class="ml-auto flex shrink-0 items-center gap-2">
                    <button
                      :if={@session.status in [:working, :retrying, :compacting]}
                      name="behavior"
                      value="steer"
                      data-steer-button
                      hidden
                    >Steer</button>
                    <button
                      :if={@session.status not in [:stopped, :failed]}
                      id="stop-button"
                      type="button"
                      phx-click="stop"
                      class="btn btn-sm btn-ghost text-error"
                    >
                      <.icon name="hero-stop" class="size-3.5" /> Stop
                    </button>
                  </div>
                </div>
              </div>
            </.form>
          </footer>
        <% else %>
          <section class="grid flex-1 place-items-center px-5 py-12">
            <p
              :if={@error}
              id="session-error"
              class="rounded-lg border border-error/30 bg-error/8 px-4 py-3 text-sm text-error"
              role="alert"
            >
              {@error}
            </p>
          </section>
        <% end %>
      </main>
    </div>
  </div>
</Layouts.app>
