<Layouts.app flash={@flash}>
  <div class="h-screen overflow-hidden bg-base-300 text-base-content">
    <div class="grid h-full lg:grid-cols-[17rem_minmax(0,1fr)]">
      <SessionComponents.sidebar
        workspace_groups={@workspace_groups}
        automation_groups={@automation_groups}
        general_sessions={@general_sessions}
        session_id={@session_id}
        delete_session_id={@delete_session_id}
        mobile_sidebar_open={@mobile_sidebar_open}
      />
      <div
        :if={@mobile_sidebar_open}
        id="mobile-sidebar-backdrop"
        phx-click="close_mobile_sidebar"
        class="fixed inset-0 z-20 bg-base-300/70 lg:hidden"
        aria-hidden="true"
      >
      </div>

      <main class="flex h-full min-h-0 flex-col overflow-hidden bg-base-300">
        <SessionComponents.mobile_header mobile_sidebar_open={@mobile_sidebar_open} />
        <div class="grid min-h-0 flex-1 place-items-center overflow-y-auto px-5 py-12">
          <div class="w-full max-w-lg">
            <h1 class="mb-2 text-xl font-semibold tracking-tight">Start a session</h1>
            <p class="mb-8 text-sm text-base-content/55">
              Start in the Matato config folder, or choose a workspace project.
            </p>
            <button
              id="start-general-button"
              type="button"
              phx-click="start_general"
              class="btn btn-primary mb-7 w-full"
            >Start without a project <.icon name="hero-arrow-right" class="size-4" /></button>
            <p class="mb-3 text-xs font-semibold uppercase tracking-wide text-base-content/45">
              Or choose a project
            </p>
            <.form for={@start_form} id="start-session-form" phx-submit="start" class="space-y-5">
              <div class="relative">
                <.icon
                  name="hero-folder"
                  class="pointer-events-none absolute inset-y-0 left-4 z-10 my-auto size-4 text-base-content/45"
                />
                <select
                  id={@start_form[:project].id}
                  name={@start_form[:project].name}
                  required
                  aria-label="Project directory"
                  class="select h-14 appearance-none !rounded-xl border-base-content/15 bg-base-200 !pl-11 !pr-12 text-sm font-medium text-base-content/85 shadow-[inset_0_1px_0_oklch(92%_0.008_55_/_0.04)] hover:border-base-content/30 hover:bg-base-100 focus:border-primary focus:bg-base-100 focus:outline-none"
                >
                  <option value="">Choose a project</option>
                  <option :for={project <- @projects} value={project.path}>{project.name}</option>
                </select>
                <.icon
                  name="hero-chevron-down"
                  class="pointer-events-none absolute inset-y-0 right-4 z-10 my-auto size-4 text-base-content/45"
                />
              </div>

              <button id="start-session-button" class="btn btn-primary w-full">
                Start in project <.icon name="hero-arrow-right" class="size-4" />
              </button>
            </.form>

            <div
              :if={@error}
              class="mt-4 rounded-lg border border-error/30 bg-error/8 px-4 py-3 text-sm text-error"
              role="alert"
            >
              {@error}
            </div>
          </div>
        </div>
      </main>
    </div>
  </div>
</Layouts.app>
